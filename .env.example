# =====================================================================
# MaxMusicBox - Variáveis de ambiente
# Copie este arquivo para ".env" e preencha com SEUS valores:
#   cp .env.example .env
# O arquivo ".env" é ignorado pelo git e guarda os segredos.
# =====================================================================

# Biblioteca de músicas (opcional). Se vazio, o app tenta ./MUSICAS.
MUSICBOX_LIBRARY="/caminho/para/MUSICAS"

# ------------------------- Mercado Pago (Pix) -------------------------
# Painel: https://www.mercadopago.com.br/developers/panel/app
#
# MODE A — MARKETPLACE COM SPLIT (recomendado):
#   A aplicação (do dono da plataforma) recebe 5% de cada pagamento.
#   O lojista conecta a conta dele pelo painel Admin (OAuth), e o token do
#   vendedor é salvo no banco. Preencha abaixo o APP_ID e o SECRET_KEY da
#   aplicação (aba "Detalhes da aplicação" / OAuth):
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# MODE B — PIX DIRETO (sem split): apenas o Access Token da conta.
# Use quando quiser receber tudo na própria conta, sem marketplace.
# MP_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# URI de callback do OAuth (MODE A). Cadastre a mesma URL na aplicação MP.
# O backend sobe um servidor local nessa porta para capturar o "code".
MP_REDIRECT_URI="http://localhost:8799/callback"

# Endpoint de autorização. Brasil:
MP_AUTH_URL="https://auth.mercadopago.com/authorization"

# E-mail do pagador (obrigatório no Pix do Mercado Pago).
MP_PAYER_EMAIL="cliente@maxmusicbox.app"

# Percentual retido pela plataforma (application_fee) no MODE A.
MP_SPLIT_PERCENT="5"
